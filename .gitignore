# Кэш Python. Пересоздаётся сам при каждом запуске, в репозитории не нужен --
# именно эти файлы и переполнили лимит веб-загрузки GitHub в 100 штук.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Ключи. В репозиторий идёт только .env.example с пустыми полями:
# в самом .env лежат BOT_TOKEN и ANTHROPIC_API_KEY, их публиковать нельзя
# никогда -- утёкший токен бота позволяет чужому человеку писать от его имени.
.env
.env.local
*.pem

# База. Внутри id пользователей, их платежи и карточки судов -- чужие
# персональные данные. Папку бот создаёт сам при первом запуске.
data/
*.db
*.db-journal
*.sqlite3

# Служебное: настройки конкретной машины и временные отчёты проверок
.claude/settings.local.json
missing.json
.DS_Store
Thumbs.db
