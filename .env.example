# Скопируй этот файл в .env и впиши свои значения:
#   cp .env.example .env
# Файл .env никогда никуда не заливай и не публикуй -- в нём секретные ключи.

# --- Telegram ---
# Получить у @BotFather -> /newbot. Выглядит как "123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BOT_TOKEN=

# Твой числовой Telegram ID (не username!). Узнать -- напиши @userinfobot.
# Можно несколько через запятую: OWNER_IDS=111111,222222
OWNER_IDS=

# --- Claude (Q&A ассистент) ---
# Получить на console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=
# По умолчанию Haiku 4.5 -- дешёвая и достаточно умная модель для этой задачи.
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=700

# --- База данных ---
# Вариант хостинга Oracle Cloud (свой сервер с постоянным диском) -- оставь
# DATABASE_URL пустым, бот сам создаст файл SQLite по пути DB_PATH.
DB_PATH=data/navarea.db
#
# Вариант хостинга Render + Neon (нет своего постоянного диска) -- впиши
# сюда строку подключения из панели Neon (Dashboard -> Connection string),
# выглядит как postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Порт для служебного веб-сервера "жив ли бот" -- нужен только на Render,
# он сам подставит сюда правильное значение через переменную PORT.
# На Oracle можно не трогать.
PORT=8080

# Публичный адрес бота (для ссылок "показать на карте" в предупреждениях).
# На Render можно НЕ трогать -- подхватится сам из RENDER_EXTERNAL_URL.
# На Oracle можно оставить пустым -- тогда ссылки будут вести на Google Maps.
# Заполняй вручную только если хочешь переопределить (например свой домен).
PUBLIC_URL=

# --- Как часто опрашивать источники NAVAREA (в минутах) ---
POLL_INTERVAL_MINUTES=30

# --- Тарифы ---
FREE_AREAS_LIMIT=2
FREE_QA_DAILY_LIMIT=5
PREMIUM_AREAS_LIMIT=10

# --- Подписка Telegram Stars ---
# 150 звёзд ~= 3$ по курсу покупки звёзд внутри приложения (на середину 2026,
# курс плавает -- если Stars подешевеют/подорожают, поправь это число).
STARS_PRICE_MONTHLY=150
